rules_version = '2';
// প্রত্যেক ব্যবহারকারী শুধু নিজের তথ্য পড়তে, লিখতে আর মুছতে পারবেন।
// অন্য কারও তথ্য কেউ দেখতে পারবে না। এর বাইরে ডাটাবেসে আর কিছু রাখা যাবে না।
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'pp', 'shop', 'rev', 'consentAt', 'updatedAt'])
        && request.resource.data.pp is string && request.resource.data.pp.size() < 200000
        && request.resource.data.shop is string && request.resource.data.shop.size() < 100000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
